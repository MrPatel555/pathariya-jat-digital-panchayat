# ========================================
# 🌐 FRONTEND ENVIRONMENT (.env.local)
# ========================================
# This is for Vite frontend (React app)
# For development: Set VITE_API_URL to http://localhost:5000
# For Vercel: Set in Vercel Dashboard → Project Settings → Environment Variables

VITE_API_URL=http://localhost:5000
# Production example:
# VITE_API_URL=https://your-railway-backend.railway.app

# ========================================
# 🔧 BACKEND ENVIRONMENT (backend/.env)
# ========================================
# This is for Node.js Express backend
# For Railway deployment, CORS_ORIGIN must match your Vercel frontend URL

# Backend Settings
PORT=5000
NODE_ENV=production
ADMIN_PASSWORD=admin123

# CORS - IMPORTANT: Update with your Vercel frontend URL
CORS_ORIGIN=https://pathariya-jat-digital-panchayat.vercel.app

# VAPID Keys for Web Push Notifications
VAPID_SUBJECT=mailto:admin@panchayat.local
VAPID_PUBLIC_KEY=your_public_key_here
VAPID_PRIVATE_KEY=your_private_key_here

# Database
DATABASE_URL=sqlite:./panchayat.db
