{
  "name": "pathariya-jat-panchayat",
  "version": "1.0.0",
  "description": "Pathariya Jat Digital Panchayat Portal",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node backend/server.js",
    "server:dev": "node backend/server.js",
    "install:all": "npm install && cd backend && npm install && cd ..",
    "build:all": "npm run build && cd backend && npm install && cd ..",
    "start": "npm run build:all && node backend/server.js",
    "heroku-postbuild": "npm run build:all"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "terser": "^5.48.0",
    "vite": "^4.3.9"
  }
}
