# 🔧 Backend Server Configuration
PORT=5000
NODE_ENV=production

# 🔐 Admin Settings
ADMIN_PASSWORD=admin123

# 🌐 CORS Configuration - Update with your Vercel frontend URL
# For Railway + Vercel, set this to your Vercel domain
CORS_ORIGIN=https://pathariya-jat-digital-panchayat.vercel.app

# 📧 Web Push Notifications - VAPID Keys
VAPID_SUBJECT=mailto:admin@panchayat.local
VAPID_PUBLIC_KEY=your_public_key_here
VAPID_PRIVATE_KEY=your_private_key_here

# 📊 Database Configuration
DATABASE_URL=sqlite:./panchayat.db

# 🚀 Railway Specific (Auto-set by Railway)
# RAILWAY_ENVIRONMENT_ID=auto
# RAILWAY_PROJECT_ID=auto
# RAILWAY_SERVICE_ID=auto

# 💡 Optional: Vercel Environment Detection
# VERCEL_URL=auto (set by Vercel automatically)
